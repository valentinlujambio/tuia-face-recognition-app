APP_NAME=Facial Recognition TP1
MODEL_NAME=w600k_r50.onnx
SIMILARITY_METRIC=cosine
# Umbral calibrado en 2b/2-train: 1:N con FPIR = 1 % en validación (buffalo_l)
SIMILARITY_THRESHOLD=0.334
EMBEDDINGS_PATH=data/embeddings.json
DATA_PATH=data
OUTPUT_PATH=output
CORS_ORIGINS="http://localhost:8080,http://frontend:8080"
MODEL_PATH=models
# Detector SCRFD (det_10g.onnx de buffalo_l) dentro de MODEL_PATH.
# Vacío: se usa el de ~/.insightface (se descarga buffalo_l si no está).
DETECTOR_MODEL_NAME=det_10g.onnx
# Score mínimo de detección y tamaño de entrada del detector
DET_SCORE_THRESHOLD=0.5
DET_INPUT_SIZE=640
# Lado mínimo (px) de la caja para aceptar un rostro
MIN_FACE_SIZE=20
# Margen relativo alrededor de la caja al recortar para buscar landmarks
ALIGN_MARGIN=0.5
# Borde negro relativo antes de detectar: SCRFD no encuentra caras que ocupan todo el cuadro (Parte 1, 2.4)
DET_PAD_RATIO=0.25
MAX_WORKERS=2
FACE_SIZE=112
# Must match your face embedding model Example: (InsightFace ArcFace is usually 512).
EMBEDDING_DIM=512

# PostgreSQL / pgvector (future integration)
USE_PGVECTOR=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=faces
POSTGRES_USER=faces_user
POSTGRES_PASSWORD=faces_pass
